# settings.cfg — Configuration for the Momir Basic thermal printer project.
# Copy this file to settings.cfg and adjust the paths for your setup.
# settings.cfg is excluded from version control (.gitignore).

[DEFAULT]

# Directory where card images (JPG) and converted BMP files are stored.
# One sub-folder per CMC value will be created here.
# Example: /home/pi/Desktop/momir
IMAGES_DIR=/home/navis/Desktop/momir

# Directory where intermediate data files are stored (AtomicCards.json,
# creatures_image_urls.json). Using a path outside the repository keeps
# large data files out of version control.
# Example: /home/pi/momir_data
DATA_DIR=/home/navis/momir_data
