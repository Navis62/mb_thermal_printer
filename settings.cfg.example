# settings.cfg — Configuration for the Momir Basic thermal printer project.
# Copy this file to settings.cfg and adjust the paths for your setup.
# settings.cfg is excluded from version control (.gitignore).

[DEFAULT]

# Directory where card images (JPG) and converted BMP files are stored.
# One sub-folder per CMC value will be created here.
# Example: /home/pi/Desktop/momir
IMAGES_DIR=/home/pi/Desktop/momir

# Directory where intermediate data files are stored (Scryfall bulk file,
# creatures_image_urls.json). Keeping this outside the repository avoids
# committing large data files.
# Example: /home/pi/momir_data
DATA_DIR=/home/pi/momir_data

# Optional. Path to the TrueType font used by the OLED display.
# By default the bundled font (assets/FredokaOne-Regular.ttf) is used. A relative
# path is relative to the project directory; if the file does not exist, the
# bundled font is used too.
# FONT_PATH=assets/FredokaOne-Regular.ttf

# Optional. Seconds of inactivity before the OLED is switched off to avoid
# burn-in (any button wakes it up; that press does nothing else). 0 = never.
# OLED_TIMEOUT=300

# Optional. Set to true if your buttons connect the pin to GND when pressed
# (e.g. the counter climbs by itself with the default wiring). Default: false.
# BUTTONS_ACTIVE_LOW=true

# Optional. Blank lines fed after each card so that its bottom comes out of the
# printer and can be torn off. Increase it if the end of the card stays inside.
# Default: 4.
# FEED_LINES=4
