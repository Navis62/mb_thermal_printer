# systemd unit for the Momir Basic thermal printer.
# Install:  see "Run on startup" in README.md
#
# Adjust User, WorkingDirectory and ExecStart if your user is not "pi" or the
# repository is not in /home/pi/mb_thermal_printer (use the virtualenv's
# python in ExecStart if you installed the dependencies in one).

[Unit]
Description=Momir Basic thermal printer
After=multi-user.target
# Give up after 5 failed starts in 5 minutes (e.g. hardware not connected)
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/mb_thermal_printer
ExecStart=/usr/bin/python3 /home/pi/mb_thermal_printer/momir_basic.py
# Restart if the program crashes; a normal stop (systemctl stop) is not restarted
Restart=on-failure
RestartSec=10
# momir_basic.py cleans up the GPIO on SIGTERM; do not wait forever for it
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
