{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python -m py_compile *)",
      "Bash(python -m ruff check *)",
      "Bash(python -m unittest *)",
      "Bash(python -m pytest *)",
      "Bash(bash -n *)",
      "Bash(node --test *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:scryfall.com)",
      "WebFetch(domain:python-escpos.readthedocs.io)",
      "WebFetch(domain:luma-oled.readthedocs.io)",
      "PowerShell(python -m py_compile *)",
      "PowerShell(python -m ruff check *)",
      "PowerShell(python -m unittest *)",
      "PowerShell(python -m pytest *)",
      "PowerShell(node --test *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git branch --show-current)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(pip install *)",
      "Bash(python -m pip install *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(*pip install *)",
      "Bash(*update.sh*)",
      "Bash(*setup.sh*)",
      "Bash(python scripts/*)",
      "Bash(python3 scripts/*)",
      "Bash(.venv/Scripts/python.exe scripts/*)",
      "Bash(sudo *)",
      "Bash(systemctl *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(pip install *)",
      "PowerShell(python -m pip install *)",
      "PowerShell(*pip install *)",
      "PowerShell(ssh *)",
      "PowerShell(scp *)",
      "PowerShell(rsync *)",
      "PowerShell(*update.sh*)",
      "PowerShell(*setup.sh*)",
      "PowerShell(python scripts*)",
      "PowerShell(.venv*python.exe scripts*)"
    ],
    "deny": [
      "Edit(./.venv/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.mjs\"",
            "timeout": 10,
            "statusMessage": "Vérification de la commande"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-file.mjs\"",
            "timeout": 60,
            "statusMessage": "Syntaxe Python / shell"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/checks-on-stop.mjs\" snapshot",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/checks-on-stop.mjs\"",
            "timeout": 180,
            "statusMessage": "Vérification des scripts"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": { "source": "github", "repo": "anthropics/claude-plugins-official" }
    }
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true
  }
}
